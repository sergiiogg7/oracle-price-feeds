# RPC endpoint of the target network (Sepolia, Arbitrum Sepolia, ...)
RPC_URL=
# Same endpoint for the optional fork test: forge test --match-contract OracleAdapterForkTest
SEPOLIA_RPC_URL=
# Private key of the deployer. Never commit a real value.
PRIVATE_KEY=0x...
# Owner of the adapter: configures assets (use a multisig on real networks)
OWNER=0x...
# Chainlink L2 sequencer uptime feed (omit on L1 networks such as Ethereum Sepolia)
SEQUENCER_FEED=0x...
